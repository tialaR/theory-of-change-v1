{
  "name": "tdm-flow-builder",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typegen": "next typegen",
    "typecheck": "tsc --noEmit --pretty false --incremental false",
    "validate:migration": "npm run typegen && npm run typecheck && npm run build",
    "check:tdm:v3": "npm run check:tdm:v3:full",
    "check:tdm:v3:quick": "node scripts/tdm-contract-v3/check.mjs --mode=quick",
    "check:tdm:v3:full": "node scripts/tdm-contract-v3/check.mjs --mode=full",
    "check:tdm:v3:ci": "node scripts/tdm-contract-v3/check.mjs --mode=ci",
    "check:tdm:migration-window": "node scripts/tdm-contract-v3/check-migration-window.mjs",
    "analyze:bundle": "next experimental-analyze",
    "analyze:bundle:output": "next experimental-analyze --output"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@xyflow/react": "^12.11.1",
    "docx": "^9.7.1",
    "html-to-image": "^1.11.11",
    "motion": "^12.42.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sass": "^1.101.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "typescript": "^6.0.3"
  }
}
