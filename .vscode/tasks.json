      "type": "shell",
      "command": "npm run audit:tdm:v2",
      "problemMatcher": []
    },
    {
      "label": "TDM: Performance boundaries",
      "type": "shell",
      "command": "npm run check:tdm:v2:performance",
      "group": "test",
      "problemMatcher": []
