{
  "name": "tdm-flow-builder",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typegen": "next typegen",
    "typecheck": "tsc --noEmit --pretty false --incremental false",
    "check:tdm:v3": "npm run check:tdm:v3:full",
    "check:tdm:v3:quick": "node scripts/tdm-contract-v3/check.mjs --mode=quick",
    "check:tdm:v3:full": "node scripts/tdm-contract-v3/check.mjs --mode=full",
    "check:tdm:v3:ci": "node scripts/tdm-contract-v3/check.mjs --mode=ci",
    "analyze:bundle": "next experimental-analyze",
    "analyze:bundle:output": "next experimental-analyze --output",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:system-chrome": "TDM_PLAYWRIGHT_BROWSER=system-chrome playwright test",
    "check:tdm:ownership": "node scripts/tdm-contract-v3/check-ownership.mjs",
    "check:tdm:react-flow": "node scripts/tdm-contract-v3/check-react-flow.mjs",
    "lint:canvas": "eslint src/app/canvas src/features/theory-of-change/canvas",
    "lint:auth": "eslint src/app/login src/features/auth src/mocks src/instrumentation.ts src/shared/ui/tdm-status-screen",
    "check:tdm:auth-msw": "node scripts/tdm-contract-v3/check-auth-msw.mjs",
    "check:tdm:i18n-routes": "node scripts/tdm-contract-v3/check-i18n-routes.mjs",
    "validate:release": "npm run check:tdm:sass-module-policy && npm run typegen && npm run typecheck && npm run lint:canvas && npm run lint:auth && npm run test:unit && npm run build && npm run test:e2e && npm run check:tdm:react-flow && npm run check:tdm:ownership && npm run check:tdm:auth-msw && npm run check:tdm:i18n-routes && npm run check:tdm:i18n-copy && npm run check:tdm:canvas-continuity && npm run check:tdm:architecture-naming && npm run check:tdm:v3:full",
    "check:tdm:canvas-continuity": "node scripts/tdm-contract-v3/check-canvas-continuity.mjs",
    "check:tdm:architecture-naming": "node scripts/tdm-contract-v3/check-architecture-naming.mjs",
    "check:tdm:i18n-copy": "node scripts/tdm-contract-v3/check-i18n-copy.mjs",
    "generate:tdm:i18n-baseline": "node scripts/tdm-contract-v3/generate-i18n-copy-baseline.mjs",
    "check:tdm:canvas-stability": "node scripts/tdm-contract-v3/check-canvas-stability-wave03.mjs",
    "shark": "node tools/sharkops/cli.mjs",
    "shark:status": "node tools/sharkops/status.mjs",
    "shark:doctor": "node tools/sharkops/doctor.mjs",
    "shark:verify": "node tools/sharkops/verify.mjs",
    "shark:new": "node tools/sharkops/new-bite.mjs",
    "shark:gate": "node tools/sharkops/gate.mjs",
    "shark:gate:commit": "node tools/sharkops/gate.mjs --stage=pre-commit",
    "shark:gate:push": "node tools/sharkops/gate.mjs --stage=pre-push",
    "shark:principles": "node tools/sharkops/principles.mjs",
    "shark:scan": "node tools/sharkops/scan.mjs",
    "shark:so-001:cycle": "node tools/sharkops/so-001-cycle.mjs",
    "test:e2e:canvas": "node scripts/playwright/run-canvas-e2e.mjs",
    "check:tdm:canvas-armor": "node scripts/tdm-contract-v3/check-canvas-armor.mjs",
    "check:tdm:god-slayer:wave01": "node scripts/tdm-contract-v3/check-god-slayer-wave01.mjs",
    "check:tdm:god-slayer:wave02": "node scripts/tdm-contract-v3/check-god-slayer-wave02.mjs",
    "check:tdm:god-slayer:wave03": "node scripts/tdm-contract-v3/check-god-slayer-wave03.mjs",
    "check:tdm:god-slayer:wave04": "node scripts/tdm-contract-v3/check-god-slayer-wave04.mjs",
    "check:tdm:visual-foundation:wave01": "node scripts/tdm-contract-v3/check-visual-foundation-wave01.mjs",
    "check:tdm:visual-foundation:wave02": "node scripts/tdm-contract-v3/check-visual-foundation-wave02.mjs",
    "check:tdm:visual-foundation:wave03": "node scripts/tdm-contract-v3/check-visual-foundation-wave03.mjs",
    "check:tdm:sass-module-policy": "node scripts/tdm-contract-v3/check-sass-module-policy.mjs",
    "check:tdm:visual-foundation:wave04": "node scripts/tdm-contract-v3/check-visual-foundation-wave04.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@xyflow/react": "^12.11.1",
    "docx": "^9.7.1",
    "html-to-image": "^1.11.11",
    "motion": "^12.42.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sass": "^1.101.0",
    "next-intl": "4.13.4",
    "msw": "2.15.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "typescript": "^6.0.3",
    "@playwright/test": "1.62.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "jsdom": "27.4.0",
    "vitest": "4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
