'use client';

import Link from 'next/link';
import { motion, useReducedMotion } from 'motion/react';
import type { CSSProperties, ReactNode } from 'react';
import styles from './example-previews.module.sass';

type PreviewCard = {
  href: string;
  icon: ReactNode;
  title: string;
  description: string;
  cta: string;
  variant: 'flow' | 'result';
};

const STAGES = [
  { key: 'input', accent: 'rgba(180, 148, 255, 0.72)' },
  { key: 'activity', accent: 'rgba(105, 184, 255, 0.68)' },
  { key: 'output', accent: 'rgba(255, 172, 82, 0.66)' },
  { key: 'outcome', accent: 'rgba(86, 226, 178, 0.7)' }
] as const;

const FLOW_LINES = [
  'M 159 128 C 211 128, 220 129, 263 129',
  'M 159 224 C 195 224, 198 130, 263 130',
  'M 159 320 C 202 320, 198 225, 263 225',
  'M 394 128 C 451 128, 464 128, 508 128',
  'M 394 224 C 447 224, 462 224, 508 224',
  'M 394 320 C 449 320, 462 320, 508 320',
  'M 639 128 C 694 128, 707 128, 750 128',
  'M 639 224 C 704 224, 699 319, 750 320',
  'M 881 177 C 913 177, 930 177, 960 177'
] as const;

const RESULT_LINES = [
  'M 158 158 C 238 158, 237 158, 316 158',
  'M 158 257 C 233 257, 240 158, 316 158',
  'M 158 356 C 239 356, 236 258, 316 258',
  'M 455 158 C 516 158, 547 158, 610 158',
  'M 455 258 C 515 258, 548 258, 610 258',
  'M 750 158 C 823 158, 841 258, 913 258',
  'M 750 258 C 820 258, 842 258, 913 258'
] as const;

const PREVIEW_CARDS: PreviewCard[] = [
  {
    href: '/exemplos/fluxo',
    icon: <FlowIcon />,
    title: 'Visualização do fluxo',
    description: 'Veja a lógica causal em rascunho visual antes de abrir a experiência completa.',
    cta: 'Abrir',
    variant: 'flow'
  },
  {
    href: '/exemplos/resultado',
    icon: <ResultIcon />,
    title: 'Resultado conectado',
    description: 'Leia a teoria organizada com relações, riscos, hipóteses e caminho causal.',
    cta: 'Abrir',
    variant: 'result'
  }
];

function FlowIcon() {
  return (
    <svg viewBox="0 0 24 24" aria-hidden="true" className={styles.cardIconSvg}>
      <path d="M7 7h3v3H7zM14 7h3v3h-3zM7 14h3v3H7zM14 14h3v3h-3z" />
      <path d="M10 8.5h4M10 15.5h4M8.5 10v4M15.5 10v4" />
    </svg>
  );
}

function ResultIcon() {
  return (
    <svg viewBox="0 0 24 24" aria-hidden="true" className={styles.cardIconSvg}>
      <path d="M6 5h12v14H6z" />
      <path d="M9 9h6M9 12h6M9 15h4" />
    </svg>
  );
}

function MiniCard({ stage, row, dense = false }: { stage: (typeof STAGES)[number]; row: number; dense?: boolean }) {
  return (
    <span
      className={`${styles.previewNode} ${dense ? styles.previewNodeDense : ''}`}
      style={{ '--stage-color': stage.accent, '--row': row } as CSSProperties}
      aria-hidden="true"
    >
      <i />
      <b />
      <em />
      <small />
    </span>
  );
}

function FlowPreview({ variant }: { variant: PreviewCard['variant'] }) {
  const lines = variant === 'flow' ? FLOW_LINES : RESULT_LINES;
  const isResult = variant === 'result';

  return (
    <div className={`${styles.previewCanvas} ${isResult ? styles.previewCanvasResult : ''}`} aria-hidden="true">
      <svg className={styles.previewLines} viewBox="0 0 1040 440" preserveAspectRatio="xMidYMid meet">
        <defs>
          <marker id={`tdm-preview-arrow-${variant}`} markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto" markerUnits="strokeWidth">
            <path d="M 0 0 L 9 4.5 L 0 9 z" />
          </marker>
        </defs>
        {lines.map((path, index) => (
          <g key={path} className={styles.previewLineGroup} style={{ '--line-index': index } as CSSProperties}>
            <path d={path} markerEnd={`url(#tdm-preview-arrow-${variant})`} />
          </g>
        ))}
        {!isResult ? (
          <>
            <circle className={styles.previewBadgeRisk} cx="206" cy="128" r="10" />
            <circle className={styles.previewBadgeRisk} cx="582" cy="128" r="10" />
            <circle className={styles.previewBadgeHypothesis} cx="814" cy="128" r="10" />
          </>
        ) : (
          <>
            <circle className={styles.previewBadgeGhost} cx="236" cy="158" r="9" />
            <circle className={styles.previewBadgeGhost} cx="538" cy="158" r="9" />
            <circle className={styles.previewBadgeGhost} cx="833" cy="258" r="9" />
          </>
        )}
      </svg>

      <div className={styles.previewGrid}>
        {isResult ? (
          <>
            <div className={styles.previewColumn} style={{ '--stage-color': STAGES[0].accent } as CSSProperties}>
              <MiniCard stage={STAGES[0]} row={1} dense />
              <MiniCard stage={STAGES[0]} row={2} dense />
              <MiniCard stage={STAGES[0]} row={3} dense />
            </div>
            <div className={styles.previewColumn} style={{ '--stage-color': STAGES[1].accent } as CSSProperties}>
              <MiniCard stage={STAGES[1]} row={1} dense />
              <MiniCard stage={STAGES[1]} row={2} dense />
            </div>
            <div className={styles.previewColumn} style={{ '--stage-color': STAGES[2].accent } as CSSProperties}>
              <MiniCard stage={STAGES[2]} row={1} dense />
              <MiniCard stage={STAGES[2]} row={2} dense />
            </div>
            <div className={styles.previewColumn} style={{ '--stage-color': STAGES[3].accent } as CSSProperties}>
              <MiniCard stage={STAGES[3]} row={2} dense />
            </div>
          </>
        ) : (
          <>
            <div className={styles.previewLooseColumn}>
              <MiniCard stage={STAGES[0]} row={1} />
              <MiniCard stage={STAGES[0]} row={2} />
              <MiniCard stage={STAGES[0]} row={3} />
            </div>
            <div className={styles.previewLooseColumn}>
              <MiniCard stage={STAGES[1]} row={1} />
              <MiniCard stage={STAGES[1]} row={2} />
              <MiniCard stage={STAGES[1]} row={3} />
            </div>
            <div className={styles.previewLooseColumn}>
              <MiniCard stage={STAGES[2]} row={1} />
              <MiniCard stage={STAGES[2]} row={2} />
            </div>
            <div className={styles.previewLooseColumn}>
              <MiniCard stage={STAGES[3]} row={2} />
            </div>
          </>
        )}
      </div>
    </div>
  );
}

export function ExamplePreviewsSection() {
  const reducedMotion = useReducedMotion();

  return (
    <section className={styles.section} aria-labelledby="example-previews-title">
      <div className={styles.heading}>
        <p>Exemplos visuais</p>
        <h2 id="example-previews-title">Escolha uma prévia para explorar.</h2>
        <span>Dois caminhos: entender o fluxo ou abrir a leitura final da teoria.</span>
      </div>

      <div className={styles.grid}>
        {PREVIEW_CARDS.map((card, index) => (
          <motion.article
            key={card.title}
            className={styles.card}
            initial={reducedMotion ? false : { opacity: 0, y: '1rem' }}
            whileInView={reducedMotion ? undefined : { opacity: 1, y: 0 }}
            viewport={{ once: true, amount: 0.25 }}
            transition={{ duration: 0.42, delay: index * 0.06, ease: [0.22, 1, 0.36, 1] }}
          >
            <div className={styles.cardHeader}>
              <span className={styles.cardIcon}>{card.icon}</span>
              <div>
                <h3>{card.title}</h3>
                <p>{card.description}</p>
              </div>
            </div>

            <FlowPreview variant={card.variant} />

            <Link href={card.href} className={styles.cardCta}>
              <span>{card.cta}</span>
              <span aria-hidden="true">→</span>
            </Link>
          </motion.article>
        ))}
      </div>
    </section>
  );
}

export default ExamplePreviewsSection;
