$ease: cubic-bezier(0.22, 1, 0.36, 1)

.section
  width: min(100%, 92rem)
  margin: 0 auto
  padding: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 3vw, 1.5rem)

.heading
  display: grid
  gap: 0.55rem
  margin-bottom: clamp(1.5rem, 3vw, 2.25rem)

  p
    margin: 0
    font-size: 0.72rem
    line-height: 1
    letter-spacing: 0.18em
    text-transform: uppercase
    color: rgba(245, 245, 247, 0.62)
    font-weight: 720

  h2
    max-inline-size: 15em
    margin: 0
    font-size: clamp(2rem, 4.2vw, 4rem)
    line-height: 0.96
    letter-spacing: -0.06em
    font-weight: 560
    color: rgba(255, 255, 255, 0.96)

  span
    max-inline-size: 42rem
    color: rgba(235, 236, 241, 0.56)
    font-size: clamp(0.95rem, 1.35vw, 1.08rem)
    line-height: 1.6

.grid
  display: grid
  grid-template-columns: repeat(2, minmax(0, 1fr))
  gap: clamp(1.25rem, 2.4vw, 1.8rem)

.card
  position: relative
  overflow: hidden
  min-block-size: clamp(27rem, 46vw, 34rem)
  display: flex
  flex-direction: column
  gap: clamp(1rem, 2vw, 1.25rem)
  padding: clamp(1.35rem, 2.4vw, 1.9rem)
  border: 0.0625rem solid rgba(255, 255, 255, 0.1)
  border-radius: 1.55rem
  background: radial-gradient(ellipse 74% 44% at 50% 0%, rgba(255, 255, 255, 0.08), transparent 66%), linear-gradient(180deg, rgba(255, 255, 255, 0.046), rgba(255, 255, 255, 0.014)), rgba(5, 6, 7, 0.72)
  box-shadow: inset 0 0.0625rem 0 rgba(255, 255, 255, 0.1), 0 1.8rem 4.5rem rgba(0, 0, 0, 0.42)
  isolation: isolate

  &::before
    content: ''
    position: absolute
    inset: 0
    z-index: -1
    pointer-events: none
    background-image: radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.05) 0 0.0625rem, transparent 0.08rem), linear-gradient(rgba(255, 255, 255, 0.018) 0.0625rem, transparent 0.0625rem), linear-gradient(90deg, rgba(255, 255, 255, 0.018) 0.0625rem, transparent 0.0625rem)
    background-size: 2.75rem 2.75rem, 4rem 4rem, 4rem 4rem
    opacity: 0.72

  &:hover .previewLineGroup path
    animation: previewLineDraw 1.12s $ease forwards

  &:hover .previewNode
    transform: translateY(-0.08rem)

.cardHeader
  position: relative
  z-index: 2
  display: grid
  grid-template-columns: auto minmax(0, 1fr)
  gap: 1rem
  align-items: flex-start

  h3
    margin: 0
    color: rgba(255, 255, 255, 0.95)
    font-size: clamp(1.2rem, 2.1vw, 1.55rem)
    line-height: 1.1
    letter-spacing: -0.035em
    font-weight: 660

  p
    max-inline-size: 38rem
    margin: 0.45rem 0 0
    color: rgba(235, 236, 241, 0.58)
    font-size: clamp(0.86rem, 1.2vw, 0.98rem)
    line-height: 1.55

.cardIcon
  display: grid
  place-items: center
  inline-size: 3.25rem
  block-size: 3.25rem
  border: 0.0625rem solid rgba(255, 255, 255, 0.11)
  border-radius: 0.78rem
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.018)), rgba(255, 255, 255, 0.025)
  box-shadow: inset 0 0.0625rem 0 rgba(255, 255, 255, 0.1), 0 0.85rem 1.8rem rgba(0, 0, 0, 0.24)

.cardIconSvg
  inline-size: 1.35rem
  block-size: 1.35rem
  fill: none
  stroke: rgba(245, 245, 247, 0.78)
  stroke-width: 1.55
  stroke-linecap: round
  stroke-linejoin: round

.previewCanvas
  position: relative
  flex: 1
  min-block-size: 16rem
  overflow: hidden
  border-radius: 1.25rem
  border: 0.0625rem solid rgba(255, 255, 255, 0.075)
  background: radial-gradient(ellipse 82% 52% at 50% 0%, rgba(255, 255, 255, 0.065), transparent 70%), rgba(5, 6, 7, 0.36)
  box-shadow: inset 0 0.0625rem 0 rgba(255, 255, 255, 0.055)

.previewCanvasResult
  background: radial-gradient(ellipse 78% 50% at 50% 0%, rgba(255, 255, 255, 0.055), transparent 68%), rgba(5, 6, 7, 0.3)

.previewLines
  position: absolute
  inset: 0
  z-index: 1
  inline-size: 100%
  block-size: 100%
  pointer-events: none

  marker path
    fill: rgba(238, 241, 246, 0.54)

.previewLineGroup
  path
    fill: none
    stroke: rgba(234, 238, 246, 0.46)
    stroke-width: 1.35
    stroke-dasharray: 5 8
    stroke-linecap: round
    stroke-linejoin: round
    vector-effect: non-scaling-stroke
    opacity: 0.78
    filter: drop-shadow(0 0 0.45rem rgba(255, 255, 255, 0.08))
    stroke-dashoffset: 0

.previewCanvas:not(.previewCanvasResult) .previewLineGroup:nth-child(1) path,
.previewCanvas:not(.previewCanvasResult) .previewLineGroup:nth-child(2) path,
.previewCanvas:not(.previewCanvasResult) .previewLineGroup:nth-child(3) path
  stroke: rgba(170, 140, 255, 0.62)

.previewCanvas:not(.previewCanvasResult) .previewLineGroup:nth-child(4) path,
.previewCanvas:not(.previewCanvasResult) .previewLineGroup:nth-child(5) path,
.previewCanvas:not(.previewCanvasResult) .previewLineGroup:nth-child(6) path
  stroke: rgba(100, 191, 255, 0.58)

.previewCanvas:not(.previewCanvasResult) .previewLineGroup:nth-child(7) path,
.previewCanvas:not(.previewCanvasResult) .previewLineGroup:nth-child(8) path
  stroke: rgba(86, 226, 178, 0.58)

.previewGrid
  position: absolute
  inset: 0
  z-index: 2
  display: grid
  grid-template-columns: 1.05fr 1.05fr 1.05fr 0.85fr
  align-items: center
  gap: clamp(1.4rem, 3.6vw, 4.5rem)
  padding: clamp(1.4rem, 3.5vw, 2.4rem)

.previewLooseColumn,
.previewColumn
  display: grid
  gap: clamp(1.2rem, 2.8vw, 2.45rem)
  align-content: center
  min-inline-size: 0

.previewColumn
  align-self: stretch
  padding: 0.55rem
  border-radius: 1rem
  border: 0.0625rem solid color-mix(in srgb, var(--stage-color) 24%, rgba(255, 255, 255, 0.05))
  background: linear-gradient(180deg, color-mix(in srgb, var(--stage-color) 5%, transparent), rgba(255, 255, 255, 0.008))

.previewNode
  --stage-color: rgba(255, 255, 255, 0.6)
  position: relative
  min-inline-size: 0
  block-size: clamp(3.5rem, 6.5vw, 5rem)
  border-radius: 0.55rem
  border: 0.0625rem solid color-mix(in srgb, var(--stage-color) 42%, rgba(255, 255, 255, 0.09))
  background: radial-gradient(circle at 18% 50%, color-mix(in srgb, var(--stage-color) 14%, transparent), transparent 42%), linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.018)), rgba(16, 18, 22, 0.62)
  box-shadow: inset 0.18rem 0 0 color-mix(in srgb, var(--stage-color) 64%, transparent), inset 0 0.0625rem 0 rgba(255, 255, 255, 0.08), 0 1rem 2rem rgba(0, 0, 0, 0.2)
  transition: transform 0.28s $ease

  i
    position: absolute
    left: 0.8rem
    top: 50%
    inline-size: 2.2rem
    block-size: 2.2rem
    border-radius: 0.28rem
    transform: translateY(-50%)
    background: color-mix(in srgb, var(--stage-color) 16%, rgba(255, 255, 255, 0.08))

  b,
  em,
  small
    position: absolute
    left: 3.7rem
    display: block
    border-radius: 999rem
    background: rgba(214, 220, 232, 0.1)
    font-style: normal

  b
    top: 1.05rem
    inline-size: 38%
    block-size: 0.42rem

  em
    top: 2rem
    inline-size: 66%
    block-size: 0.42rem

  small
    top: 2.85rem
    inline-size: 54%
    block-size: 0.42rem

.previewNodeDense
  block-size: clamp(3.2rem, 6vw, 4.65rem)

.previewBadgeRisk,
.previewBadgeHypothesis,
.previewBadgeGhost
  fill: rgba(8, 9, 12, 0.78)
  stroke-width: 1
  vector-effect: non-scaling-stroke

.previewBadgeRisk
  stroke: rgba(255, 160, 94, 0.5)

.previewBadgeHypothesis
  stroke: rgba(86, 226, 178, 0.52)

.previewBadgeGhost
  stroke: rgba(245, 245, 247, 0.34)

.cardCta
  position: relative
  z-index: 3
  display: inline-flex
  align-items: center
  gap: 0.5rem
  align-self: flex-start
  margin-top: auto
  color: rgba(245, 245, 247, 0.9)
  text-decoration: none
  font-size: 0.92rem
  line-height: 1
  font-weight: 720

  span:last-child
    transition: transform 0.22s $ease

  &:hover span:last-child
    transform: translateX(0.22rem)

@keyframes previewLineDraw
  0%
    stroke-dasharray: 0 420
    stroke-dashoffset: 0
    opacity: 0
  12%
    opacity: 0.82
  100%
    stroke-dasharray: 5 8
    stroke-dashoffset: -34
    opacity: 0.9

@media (prefers-reduced-motion: reduce)
  .card:hover .previewLineGroup path
    animation: none

  .previewNode
    transition: none

@media (max-width: 64rem)
  .grid
    grid-template-columns: 1fr

  .card
    min-block-size: 30rem

@media (max-width: 42rem)
  .section
    padding-inline: 0.8rem

  .cardHeader
    grid-template-columns: 1fr

  .previewGrid
    gap: 1rem
    padding: 1rem

  .previewNode
    block-size: 3.3rem

    i
      inline-size: 1.6rem
      block-size: 1.6rem
      left: 0.55rem

    b,
    em,
    small
      left: 2.55rem
