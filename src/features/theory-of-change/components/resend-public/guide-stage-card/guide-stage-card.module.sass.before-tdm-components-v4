.root
  --guide-stage-card-accent: rgba(232, 235, 242, 0.92)
  position: relative
  width: 100%
  padding-top: clamp(1.7rem, 2.4vw, 2.625rem)
  isolation: isolate

  &::before
    content: ''
    position: absolute
    z-index: -2
    inset: 0 auto auto 0
    inline-size: 100%
    block-size: calc(100% + 5rem)
    border-block-start: 0.0625rem solid rgba(123, 132, 142, 0.34)
    border-inline-end: 0.0625rem solid rgba(123, 132, 142, 0.34)
    border-start-end-radius: clamp(3.2rem, 5vw, 6rem)
    pointer-events: none

.card
  box-sizing: border-box
  position: relative
  z-index: 1
  overflow: hidden
  inline-size: calc(100% - clamp(2rem, 4vw, 5rem))
  min-block-size: clamp(20rem, 32vw, 36.25rem)
  margin-inline-start: clamp(1rem, 2.35vw, 2.3125rem)
  border: 0.0625rem solid rgba(96, 113, 124, 0.31)
  border-radius: clamp(2.6rem, 4.4vw, 4rem)
  background: radial-gradient(78% 48% at 49% -3%, rgba(255, 255, 255, 0.105) 0%, rgba(255, 255, 255, 0.052) 39%, rgba(255, 255, 255, 0) 78%), radial-gradient(72% 65% at 86% 101%, color-mix(in srgb, var(--guide-stage-card-accent) 20%, transparent) 0%, color-mix(in srgb, var(--guide-stage-card-accent) 9%, transparent) 44%, transparent 78%), linear-gradient(180deg, #151616 0%, #111312 33%, #0b0e0c 66%, #070a08 100%)
  box-shadow: inset 0 0.0625rem 0 rgba(255, 255, 255, 0.015), 0 1.6rem 4rem rgba(0, 0, 0, 0.46)

@media (max-width: 56rem)
  .card
    inline-size: calc(100% - 2rem)
    min-block-size: auto
    margin-inline-start: 1rem
