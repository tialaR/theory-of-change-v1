.root
  --guide-stage-card-accent: rgba(232, 235, 242, 0.92)
  position: relative
  isolation: isolate
  box-sizing: border-box
  width: 100%
  padding: clamp(0.72rem, 1.35vw, 1.16rem)
  border-radius: clamp(2.65rem, 4.6vw, 4.55rem)
  overflow: hidden
  background: radial-gradient(75% 74% at 82% 105%, color-mix(in srgb, var(--guide-stage-card-accent) 52%, transparent) 0%, color-mix(in srgb, var(--guide-stage-card-accent) 22%, transparent) 36%, transparent 72%), linear-gradient(132deg, color-mix(in srgb, var(--guide-stage-card-accent) 34%, rgba(255, 255, 255, 0.34)) 0%, color-mix(in srgb, var(--guide-stage-card-accent) 16%, rgba(255, 255, 255, 0.2)) 24%, rgba(83, 90, 96, 0.42) 53%, color-mix(in srgb, var(--guide-stage-card-accent) 46%, rgba(255, 255, 255, 0.4)) 100%)
  box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.52), 0 0 0 0.0625rem rgba(255, 255, 255, 0.055)

  &::before
    content: ''
    position: absolute
    inset: -18% -12% auto 34%
    block-size: 72%
    border-radius: 999rem
    background: radial-gradient(ellipse at 50% 50%, color-mix(in srgb, var(--guide-stage-card-accent) 28%, rgba(255, 255, 255, 0.1)), transparent 72%)
    filter: blur(2.2rem)
    opacity: 0.74
    pointer-events: none

  &::after
    content: ''
    position: absolute
    inset: 0
    border-radius: inherit
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.16), transparent 28%, rgba(255, 255, 255, 0.05) 100%)
    mix-blend-mode: screen
    opacity: 0.34
    pointer-events: none

.card
  box-sizing: border-box
  position: relative
  z-index: 1
  overflow: hidden
  width: 100%
  min-block-size: 0
  border-radius: clamp(2.05rem, 3.65vw, 3.75rem)
  border: 0.0625rem solid rgba(255, 255, 255, 0.075)
  background: radial-gradient(86% 70% at 77% 100%, color-mix(in srgb, var(--guide-stage-card-accent) 18%, transparent) 0%, color-mix(in srgb, var(--guide-stage-card-accent) 8%, transparent) 42%, transparent 76%), radial-gradient(78% 42% at 51% -3%, rgba(255, 255, 255, 0.105) 0%, rgba(255, 255, 255, 0.042) 42%, transparent 78%), linear-gradient(180deg, #1a1d1d 0%, #131616 42%, #0d100f 73%, #070908 100%)
  box-shadow: inset 0 0.0625rem 0 rgba(255, 255, 255, 0.1), inset 0 -2.25rem 4.5rem rgba(0, 0, 0, 0.34), inset 0 0 4rem color-mix(in srgb, var(--guide-stage-card-accent) 7%, transparent)

  &::before
    content: ''
    position: absolute
    inset: 0
    border-radius: inherit
    background: linear-gradient(112deg, transparent 0%, rgba(255, 255, 255, 0.045) 43%, color-mix(in srgb, var(--guide-stage-card-accent) 11%, transparent) 78%, transparent 100%)
    opacity: 0.74
    pointer-events: none

@media (max-width: 56rem)
  .root
    padding: 0.72rem
    border-radius: 2.45rem

  .card
    border-radius: 1.85rem
